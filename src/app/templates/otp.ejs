<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f4f4f4;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0">
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="background: #ffffff; border-radius: 10px; overflow: hidden"
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: #2563eb;
                  color: white;
                  padding: 25px;
                  font-size: 28px;
                  font-weight: bold;
                "
              >
                OTP Verification
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 40px">
                <h2 style="margin-top: 0">Hello, <%= name %> 👋</h2>

                <p style="color: #555; font-size: 16px; line-height: 1.7">
                  We received a request to verify your account. Use the One-Time
                  Password (OTP) below to continue.
                </p>

                <div style="margin: 30px 0; text-align: center">
                  <span
                    style="
                      display: inline-block;
                      background: #f3f4f6;
                      border: 2px dashed #2563eb;
                      padding: 18px 40px;
                      font-size: 32px;
                      font-weight: bold;
                      letter-spacing: 8px;
                      color: #2563eb;
                      border-radius: 8px;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <p style="color: #666; font-size: 15px; line-height: 1.7">
                  This OTP is valid for
                </p>

                <p style="color: #666; font-size: 15px; line-height: 1.7">
                  If you didn't request this code, you can safely ignore this
                  email.
                </p>

                <hr
                  style="
                    border: none;
                    border-top: 1px solid #eee;
                    margin: 35px 0;
                  "
                />

                <p style="color: #999; font-size: 13px; text-align: center">
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background: #f9fafb;
                  padding: 18px;
                  color: #888;
                  font-size: 13px;
                "
              >
                © <%= new Date().getFullYear() %> Tour Management System. All
                rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
